                            class="lucide lucide-mail-icon lucide-mail h-[3vw] md:h-[1vw]">
                            <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                        </svg> <%=e.email%></p>
                    <p class="text-[2.9vw] md:text-[0.8vw] flex gap-[1.9vw] md:gap-[0.4vw] items-center mt-[0.8vw] md:mt-[0.5vw]"><svg
                            xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-phone-icon lucide-phone h-[3vw] md:h-[1vw]">
                            <path
                                d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
                        </svg> <%= e.mob %></p>
                    <hr class="text-gray-200 mt-[0.5vw]">
                    <div class="w-full flex justify-between text-[2.7vw] md:text-[0.9vw] mt-[1.8vw] md:mt-[0.3vw]">
                        <p>Status:</p>
                        <div class="w-[45vw] md:w-[11vw] flex gap-[1.3vw] md:gap-[0.5vw]">

                            <% if(e.active){%>

                            
                            
                            <a href="/admin/activeReq/<%=e._id%>" onclick="activeUser(event,this)"
                                class="w-1/2 flex items-center justify-center p-[1.1vw] md:p-[0.3vw]  bg-green-200 text-green-700 font-medium rounded-sm">
                                Active</a>
                            <a href="/admin/inActive/<%=e._id%>" onclick="inActiveUser(event,this)"
                                class="w-1/2 flex items-center justify-center p-[1.1vw] md:p-[0.3vw] border-1 border-gray-400 rounded-sm">
                                Inactive</a>

                            <% }else {  %>
                                <a href="/admin/activeReq/<%=e._id%>" onclick="activeUser(event,this)"
                                class="w-1/2 flex items-center justify-center p-[1.1vw] md:p-[0.3vw] border-1 border-gray-400    rounded-sm">
                                Active</a>
                            <a href="/admin/inActive/<%=e._id%>" onclick="inActiveUser(event,this)"
                                class="w-1/2 flex items-center justify-center p-[1.1vw] md:p-[0.3vw] bg-red-200 text-red-700 rounded-sm">
                                Inactive</a>

                            <% }%>
                            
                        </div>
                    </div>
                    <div class="w-full flex justify-between text-[2.7vw] md:text-[0.9vw] mt-[1.8vw] md:mt-[0.3vw]">
                        <p>Role:</p>
                        <div class="w-[45vw] md:w-[11vw] flex  gap-[1.3vw] md:gap-[0.5vw]">

                            <% if(e.super){ %>
                            
                            <a href="/admin/disableSuper/<%=e._id%>" onclick="disableSuper(event,this)"
                                class="w-1/2 flex items-center justify-center p-[1.1vw] md:p-[0.3vw] border-1 border-gray-400    rounded-sm">
                                Admin</a>
                            <a href="/admin/superAdmin/<%=e._id%>" onclick="superAdmin(event,this)"
                                class="w-1/2 flex items-center justify-center p-[1.1vw] md:p-[0.3vw] bg-orange-200 text-red-700 rounded-sm">
                                Super Ad</a>
                            <% }else{ %>
                                <a  href="/admin/disableSuper/<%=e._id%>" onclick="disableSuper(event,this)"
                                class="w-1/2 flex items-center justify-center p-[1.1vw] md:p-[0.3vw]  bg-green-200 text-green-700  rounded-sm">
                                Admin</a>
                            <a  href="/admin/superAdmin/<%=e._id%>" onclick="superAdmin(event,this)"
                                class="w-1/2 flex items-center justify-center p-[1.1vw] md:p-[0.3vw] border-1 border-gray-400 rounded-sm">
                                Super Ad</a>

                            <% } %>
                        </div>
                    </div>

                </div>
                <% }) %>


                <!-- -------------------------- Repeating admin Card  End----------------------- -->









            </div>



            <!-- ---------------------------------------------------------------------------------------------------------------- section end  -->
        </div>

    </section>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js"
        integrity="sha512-NcZdtrT77bJr4STcmsGAESr06BYGE8woZdSdEgqnpyqac7sugNO+Tr4bGwGF3MsnEkGKhU2KL2xh6Ec+BqsaHA=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        window.addEventListener("pageshow", function (event) {

            if (event.persisted) {
                window.location.reload();
            }

        });

         async function inActiveUser(event,element){
            event.preventDefault();
            let response = await fetch(element.href);
            if(!response){
                throw new Error("Inactivation failed");
            }

            let data = await response.json();
            if(data.success){
                window.location.reload();
            }
            else{
                alert(data.message);
            }

         }
         async function disableSuper(event,element){
            event.preventDefault();
            let response = await fetch(element.href);
            if(!response){
                throw new Error("super deactivation failed");
            }

            let data = await response.json();
            if(data.success){
                window.location.reload();
            }
            else{
                alert(data.message);
            }

         }
         async function activeUser(event,element){
            event.preventDefault();
            let response = await fetch(element.href);
            if(!response){
                throw new Error("activation failed");
            }

            let data = await response.json();
            if(data.success){
                window.location.reload();
            }
            else{
                alert(data.message);
            }

         }
         async function superAdmin(event,element){
            event.preventDefault();
            let response = await fetch(element.href);
            if(!response){
                throw new Error("super activation failed");
            }

            let data = await response.json();
            if(data.success){
                window.location.reload();
            }
            else{
                alert(data.message);
            }

         }

        function followLink(event, element) {
            event.preventDefault();
            window.location.replace(element.href);
        }
        async function goLink(event, element) {
            event.preventDefault();
            let response = await fetch(element.href);

            if (!response.ok) {
                throw new Error("Logout failed");
            }
            let data = await response.json();
            if (data.success) {
                window.location.replace("/admin/login");
            }
            else {
                alert(data.message);
            }
        }
    </script>
    <script src="/scripts/sidebar.js"></script>
</body>

</html>