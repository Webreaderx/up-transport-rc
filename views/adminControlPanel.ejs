<body class="flex flex-col min-h-screen overflow-x-hidden">
    <nav class=" h-23 md:h-auto flex items-center justify-between relative bg-white">
        <div class="flex gap-2 p-2 items-center h-full">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="menu"
                class="lucide lucide-menu-icon lucide-menu h-[5vw] flex md:hidden">
                <path d="M4 5h16" />
                <path d="M4 12h16" />
                <path d="M4 19h16" />
            </svg>
            <img class=" h-[14vw] md:h-[5vw]" src="/images/UPLogo.png" alt="">
            <div>
                <h3 class="text-[4vw] md:text-[1.6vw] tracking-tight sm:leading-tight font-medium">Uttar Pradesh State
                    Transport</h3>
                <p class=" text-xs md:text-[1vw]">Vehical Registration Portal</p>
            </div>
        </div>
        <div class="h-full gap-4 pr-5 flex items-center">
            <div class="h-full hidden md:flex items-center  ">
                <img class="h-7/10 md:h-[4vw]" src="/images/secure.png" alt="">
