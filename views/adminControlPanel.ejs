        const cldlNotification = document.getElementById("cldlNotification");
        const dlUsertick = document.getElementById("dlUsertick");
        const dlAdmintick = document.getElementById("dlAdmintick");
        const dlVehicletick = document.getElementById("dlVehicletick");
        const dlNotificationtick = document.getElementById("dlNotificationtick");
        const dlByUserEmail = document.getElementById("dlByUserEmail")
        const dlByAdminEmail = document.getElementById("dlByAdminEmail")

        dlUserbtn.addEventListener("click", (e) => {
            e.preventDefault();
            dlUser.classList.remove("hidden");
        })
        cldlUser.addEventListener("click", (e) => {
            e.preventDefault();
            dlUser.classList.add("hidden");
        })
        dlAdminbtn.addEventListener("click", (e) => {
            e.preventDefault();
            dlAdmin.classList.remove("hidden");
        })
        cldlAdmin.addEventListener("click", (e) => {
            e.preventDefault();
            dlAdmin.classList.add("hidden");
        })
        dlVehiclebtn.addEventListener("click", (e) => {
            e.preventDefault();
            dlVehicle.classList.remove("hidden");
        })
        cldlVehicle.addEventListener("click", (e) => {
            e.preventDefault();
            dlVehicle.classList.add("hidden");
        })
        dlNotificationbtn.addEventListener("click", (e) => {
            e.preventDefault();
            dlNotification.classList.remove("hidden");
        })
        cldlNotification.addEventListener("click", (e) => {
            e.preventDefault();
            dlNotification.classList.add("hidden");
        })

        dlUsertick.addEventListener("click", async (e) => {
            e.preventDefault();
            let response = await fetch("/admin/deleteAllUsers");
            if (!response.ok) {
                throw new Error("Deletion failed");
            }

            let data = await response.json();
            if (data.success) {


                dlUser.classList.add("hidden");
                window.location.reload();
            }
            else {
                alert(data.message);
            }
        })
        dlAdmintick.addEventListener("click", async (e) => {
            e.preventDefault();
            let response = await fetch("/admin/deleteAllAdmins");
            if (!response.ok) {
                throw new Error("Deletion failed");
            }

            let data = await response.json();
            if (data.success) {


                dlAdmin.classList.add("hidden");
                window.location.reload();
            }
            else {
                alert(data.message);
            }
        })
        dlVehicletick.addEventListener("click", async (e) => {
            e.preventDefault();
            let response = await fetch("/admin/deleteAllVehicles");
            if (!response.ok) {
                throw new Error("Deletion failed");
            }

            let data = await response.json();
            if (data.success) {


                dlAdmin.classList.add("hidden");
                window.location.reload();
            }
            else {
                alert(data.message);
            }
        })
        dlNotificationtick.addEventListener("click", async (e) => {
            e.preventDefault();
            let response = await fetch("/admin/deleteAllNotifications");
            if (!response.ok) {
                throw new Error("Deletion failed");
            }

            let data = await response.json();
            if (data.success) {


                dlAdmin.classList.add("hidden");
                window.location.reload();
            }
            else {
                alert(data.message);
            }
        })

        dlByUserEmail.addEventListener("click", async () => {


            let email = document.getElementById("byUserEmail").value;
            let response = await fetch(`/admin/deleteUserByEmail/${email}`);
            if (!response.ok) {
                throw new Error("Deletion failed");
            }

            let data = await response.json();
            if (data.success) {

                window.location.reload();
            }
            else {
                alert(data.message);
            }

        })
        dlByAdminEmail.addEventListener("click", async () => {


            let email = document.getElementById("byAdminEmail").value;
            let response = await fetch(`/admin/deleteAdminByEmail/${email}`);
            if (!response.ok) {
                throw new Error("Deletion failed");
            }

            let data = await response.json();
            if (data.success) {

                window.location.reload();
            }
            else {
                alert(data.message);
            }

        })

        const toggle = document.getElementById("toggle");
        toggle.addEventListener("click", async () => {
            if (<%= flag %>){

            let response = await fetch("/admin/messageOff");
            if (!response.ok) {
                throw new Error("Message Off failed");

            }
            let data = await response.json();
            if (data.success) {
                window.location.reload();
            }
            else {
                alert(data.message);
            }

        }
            else {


            let response = await fetch("/admin/messageOn");
            if (!response.ok) {
                throw new Error("Message ON failed");

            }
            let data = await response.json();
            if (data.success) {
                window.location.reload();
            }
            else {
                alert(data.message);
            }

        }
        })

        function followLink(event, element) {
            event.preventDefault();
            window.location.replace(element.href);
        }
        async function goLink(event, element) {
            event.preventDefault();
            let response = await fetch(element.href);

            if (!response.ok) {
                throw new Error("Logout failed");
            }
            let data = await response.json();
            if (data.success) {
                window.location.replace("/admin/login");
            }
            else {
                alert(data.message);
            }
        }
    </script>
    <script src="/scripts/sidebar.js"></script>
</body>

