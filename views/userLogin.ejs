<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <style>
        body {

            font-family: "Inter", sans-serif;

        }
        .cardshadow{
            box-shadow: 0 0 5px gray;
        }
        .backsec {
            background: url("/public/images/bgfull.png") no-repeat center center/cover;
            position: relative;

        }

        .texo {
            text-shadow: 0 0 60px white;
        }

        .gradi {
            background: linear-gradient(to right, rgba(243, 243, 243, 0.616), Transparent);

        }
    </style>
</head>

<body class="">
    <nav class=" h-[19vw] md:h-[6vw] flex items-center justify-between relative bg-white">
        <div class="flex gap-2 p-2 md:p-[0.5vw] items-center h-full">
            <img class="h-full" src="/images/UPLogo.png" alt="">
            <div>
                <h3 class="text-[4vw] md:text-[1.8vw] tracking-tight sm:leading-tight font-medium">Uttar Pradesh State
                    Transport</h3>
                <p class=" text-xs md:text-[1vw]">Vehical Registration Portal</p>
            </div>
        </div>
        <div class="h-full gap-4 pr-5 flex items-center">
            <div class="h-full hidden md:flex items-center  ">
                <img class="h-7/10" src="/images/secure.png" alt="">
                <div class="h-full flex flex-col  justify-center ">
                    <h2 class=" text-sm font-medium border-r-3 border-zinc-300">Official Portal</h2>
                    <p class="text-xs border-r-3 border-zinc-300 pr-3">Goverment of Uttar Pradesh</p>
                </div>
            </div>
            <div class="h-full flex items-center">
                <img class=" h-6/10 md:h-7/10" src="/images/support.png" alt="">
                <div class="h-full flex flex-col  justify-center">
                    <h2 class=" text-sm hidden md:flex font-medium">Need Help ?</h2>
                    <p class="text-xs hidden md:flex ">Support and FAQ</p>
                </div>
            </div>

        </div>
    </nav>

    <section class=" h-[135vw] md:h-screen bg-[url('/images/bgfull.png')] bg-cover bg-[position:12%_center]">
        <div class="h-[100%] flex flex-col md:flex-row ">
            <div class="gradi h-[100%] width-full md:w-1/2 flex flex-col pl-[9vw] md:pl-40 pt-[10vw] md:pt-30 pr-9 md:pr-0">


                <h2 class=" text-[7vw] md:text-[2.2vw] text-blue-800 font-bold texo">Welcome Back</h2>
                <p class="text-[5vw] md:text-[3.5vw] text-black font-medium texo ">Login to Your Account</p>
                <hr class="h-1 mt-6 bg-black border-2 hidden md:flex border-gray-500 w-1/2">
                <p class="texo md:text-[1.2vw] hidden md:flex font-medium">Access your account to manage your vehicle registrations and
                    track applications status.</p>
            </div>
            <div class="h-[90%] w-1/2 flex hidden md:flex items-center justify-center p-[2vw] gap-4 ">
                <form action="/user/login" method="post" class="w-7/10 h-full flex flex-col items-center p-[1.5vw] justify-center rounded-2xl bg-white">
                    <img class="h-[6vw] bg-blue-100 rounded-full" src="/images/login.png" alt="">
                    <h3 class="text-[2vw] font-bold">Login</h3>
                    <p class="text-[1.1vw]">Enter your credential to access your account</p>
                    <div class="w-full flex gap-2 p-[1vw]  items-center justify-center">
                        
                    </div>
                    <div
                        class="w-14/15 border-2 flex border-zinc-300 px-3 py-[0.8vw] mt-[0.3vw] gap-2 items-center justify-center rounded-md">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-user-round-icon lucide-user-round h-[1.3vw] text-gray-500">
                            <circle cx="12" cy="8" r="5" />
                            <path d="M20 21a8 8 0 0 0-16 0" />
                        </svg>
                        <input class="w-full text-[1.1vw] px-[1vw] outline-none" placeholder="Enter Your Email"
                            type="text" name="email">
                    </div>
                    <div
                        class="w-14/15 border-2 flex border-zinc-300 px-3 py-[0.8vw] mt-[0.3vw] gap-2 items-center justify-center rounded-md">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-key-round-icon lucide-key-round h-[1.3vw] text-gray-500">
                            <path
                                d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" />
                            <circle cx="16.5" cy="7.5" r=".5" fill="currentColor" />
                        </svg>
                        <input class="w-full text-[1.1vw] px-[1vw] outline-none " placeholder="Enter Your Password"
                            type="password" name="password">
                    </div>
                    <input class="w-14/15 bg-blue-700 text-white p-[0.6vw] text-[1.1vw] rounded-md mt-2" type="submit"
                        value="Login to Account >">
                    <div class="w-14/15 relative h-[2vw] flex items-center justify-center">
                        <hr class="w-full border-1 border-zinc-300">
                        <p class="text-[1vw] absolute bg-white px-1">New User ?</p>
                    </div>
                    <a class="w-12/15 text-center flex items-center justify-center gap-2 border-2 border-blue-600 rounded-md text-blue-800 p-2 text-[1.2vw]"
                        href="/user/register"> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-user-round-icon lucide-user-round h-[1.3vw]">
                            <circle cx="12" cy="8" r="5" />
                            <path d="M20 21a8 8 0 0 0-16 0" />
                        </svg> Create New Account</a>
                </form>

                
            </div>
        </div>
    </section>


    <div class="  w-full flex flex md:hidden mb-[2vw] items-center justify-center p-[1vw] p-[4vw] gap-4 -mt-[100vw]">
        <form action="/user/login" method="post" class="w-full h-full flex flex-col cardshadow items-center p-[1.5vw] py-[5vw] justify-center rounded-lg bg-white">
            <img class="h-[19vw] bg-blue-100 rounded-full" src="/images/login.png" alt="">
            <h3 class="text-[6.4vw] font-bold">Login</h3>
            <p class="text-[3.2vw]">Enter your credential to access your account</p>
            <div class="w-full flex gap-2 p-[1vw]  items-center justify-center">
                
            </div>
            <div
                class="w-14/15 border-2 flex border-zinc-300 px-3 py-[1.2vw] mt-[1.7vw] gap-2 items-center justify-center rounded-md">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    class="lucide lucide-user-round-icon lucide-user-round h-[3.4vw]">
                    <circle cx="12" cy="8" r="5" />
                    <path d="M20 21a8 8 0 0 0-16 0" />
                </svg>
                <input class="w-full text-[4vw] px-[1vw] outline-none" placeholder="Enter Your Email" type="text" name="email">
            </div>
            <div
                class="w-14/15 border-2 flex border-zinc-300 mt-[4vw] px-3 py-[1.2vw] mt-[2vw] gap-2 items-center justify-center rounded-md">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    class="lucide lucide-key-round-icon lucide-key-round h-[3.4vw]">
                    <path
                        d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" />
                    <circle cx="16.5" cy="7.5" r=".5" fill="currentColor" />
                </svg>
                <input class="w-full text-[4vw] px-[1vw] outline-none" placeholder="Enter Your Password"
                    type="password" name="password">
            </div>
            <input class="w-14/15 bg-blue-700 text-white  p-[2.5vw] text-[3.5vw] rounded-md mt-[3vw]" type="submit"
                value="Login to Account >">
            <div class="w-14/15 relative mt-[5vw] mb-[3vw] h-[6vw] flex items-center justify-center">
                <hr class="w-full border-1 border-zinc-300">
                <p class="text-[2.7vw] absolute bg-white px-[1vw]">New User ?</p>
            </div>
            <a class="w-12/15 text-center flex items-center justify-center gap-2 border-2 border-blue-600 rounded-md text-blue-800 p-2 text-[3.4vw]"
                href="/user/register"> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    class="lucide lucide-user-round-icon lucide-user-round h-[3.3vw]">
                    <circle cx="12" cy="8" r="5" />
                    <path d="M20 21a8 8 0 0 0-16 0" />
                </svg> Create New Account</a>
        </form>

        

    </div>


    <div class="w-[100%] flex items-center p-[4vw] md:p-0 justify-center">
        <div
            class="w-[100%]  md:w-10/12 bg-white overflow-hidden shadow-[0_0_15px_0_rgba(0,0,0,0.5)]  md:m-10 -mt-[2vw] md:-mt-14 items-center flex flex-col md:flex-row rounded-lg md:rounded-3xl">
            <div class=" w-full md:w-1/4  gap-2 flex md:pr-1 px-[5vw] py-[2vw] md:p-5 md:px-5 md:py-5 h-full">
                <img class=" h-[14vw] md:h-[5.5vw]" src="/images/secure.png" alt="">
                <div class=" md:border-r-3 flex flex-col justify-center border-zinc-300">
                    <h2 class=" text-[3.1vw] md:text-[1.3vw] font-medium">Secure & Reliable</h2>
                    <p class=" text-[2.6vw] md:text-[1vw]">100% secure platform for your information</p>
                </div>
            </div>
            <hr class="border-1 md:border-none border-zinc-400 w-8/10 md:w-0 ">
            <div class="w-full md:w-1/4 gap-2 flex md:pr-1 px-[5vw] py-[2vw] md:p-5 md:px-5 md:py-5 h-full">
                <img class="h-[14vw] md:h-[5.5vw]" src="/images/eassy.png" alt="">
                <div class="md:border-r-3 flex flex-col justify-center border-zinc-300">
                    <h2 class="text-[3.1vw] md:text-[1.3vw] font-medium">Easy Registration</h2>
                    <p class="text-[2.6vw] md:text-[1vw]">Simple Steps to register your vehicle online</p>
                </div>
            </div>
            <hr class="border-1 md:border-none border-zinc-400 w-8/10 md:w-0 ">
            <div class="w-full md:w-1/4 gap-2 flex md:pr-1 px-[5vw] py-[2vw] md:p-5 md:px-5 md:py-5 h-full">
                <img class="h-[14vw] md:h-[5.5vw]" src="/images/track.png" alt="">
                <div class="md:border-r-3 flex flex-col justify-center border-zinc-300">
                    <h2 class="text-[3.1vw] md:text-[1.3vw] font-medium">Track Application</h2>
                    <p class="text-[2.6vw] md:text-[1vw]">Track your application at every stage</p>
                </div>
            </div>
            <hr class="border-1 md:border-none border-zinc-400 w-8/10 md:w-0 ">
            <div class="w-full md:w-1/4  gap-2 flex  px-[5vw] py-[2vw] md:p-5 md:px-5 md:py-5 h-full">
                <img class="h-[14vw] md:h-[5.5vw]" src="/images/support.png" alt="">
                <div class="flex flex-col justify-center">
                    <h2 class="text-[3.1vw] md:text-[1.3vw] font-medium">24/7 Support</h2>
                    <p class="text-[2.6vw] md:text-[1vw]">We are here to help you anytime,anywhere</p>
                </div>
            </div>

        </div>
    </div>
</body>

</html>