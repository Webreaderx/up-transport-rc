                    <div
                        class="h-full p-[1vw] bg-white w-full  flex gap-[1vw] items-center shadow-lg shadow-gray-300 rounded-lg">
                        <img class="h-[15vw] md:h-[5vw] bg-red-100 p-[1.3vw] md:p-[0.5vw] rounded-full "
                            src="/images/reject2.png" alt="">
                        <div class="w-full h-full flex flex-col justify-center gap-[0.5vw] ">
                            <p class="text-[3vw] md:text-[1vw] font-medium">Rejected</p>
                            <h2 class="text-[5vw] md:text-[2.5vw] font-medium">
                                <%=rejected.length%>
                            </h2>
                        </div>
                    </div>
                </div>
            </div>

            <div
                class=" w-[96%] md:w-full min-h-[20vw] md:max-h-[38vw] md:overflow-y-scroll  flex flex-col md:shadow-lg md:shadow-gray-300 md:bg-white items-center mt-[2.5vw] md:mt-[1vw] p-[1vw]  rounded-md md:rounded-xl ">
                <div class="w-full flex justify-between">
                    <h2 class="text-[4vw] md:text-[1.6vw] font-medium pl-[1vw]">Applications</h2>

                    <div class="w-full flex justify-end gap-[1vw] pb-[1vw]">
                        <a class="text-[2.5vw] md:text-[1vw] px-[1.3vw] py-[0.9vw] bg-blue-500 text-white rounded-sm md:rounded-md"
                            href="/admin/applications" onclick="followLink(event,this)" >All Applications</a>
                        <a class="text-[2.5vw] md:text-[1vw] px-[1.3vw] py-[0.9vw] bg-gray-200 rounded-sm md:rounded-md"
                            href="/admin/applicationsReqested" onclick="followLink(event,this)" >Requested</a>
                    </div>
                </div>
                <div class="w-full flex hidden md:flex relative rounded-md ">
                    <div class="w-3/5 flex ">
                        <p class="w-3/7 bg-gray-100 rounded-l-md text-[1.1vw] font-medium p-[1.2vw]">Application ID</p>
                        <p class="w-2/7 bg-gray-100 text-[1.1vw] font-medium p-[1.2vw]">Vehicle Number</p>
                        <p class="w-2/7 bg-gray-100 text-[1.1vw] font-medium p-[1.2vw]">Applied On</p>
                    </div>
                    <div class="w-2/5 flex ">
                        <p class="w-1/2 bg-gray-100 text-[1.1vw] font-medium p-[1.2vw]">Status</p>
                        <p class="w-1/2 bg-gray-100 text-[1.1vw] rounded-r-md font-medium p-[1.2vw]"> Action</p>

                    </div>


                </div>

                <!-- ---------------  Repeating parts for applications------------------------------------------------ -->


                <% applications.forEach((e)=>{ %>

                    <div
                        class="w-full bg-white rounded-md p-[3vw] shadow-md  md:shadow-none md: shadow-gray-0 shadow-gray-300 mt-[2vw] md:mt-0 md:p-0">
                        <div class="w-full flex  md:flex-row  overflow-y-hidden">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-notepad-text-icon lucide-notepad-text  h-[7vw] bg-blue-100 p-[1vw] rounded-full m-[1.6vw] flex md:hidden">
                                <path d="M8 2v4" />
                                <path d="M12 2v4" />
                                <path d="M16 2v4" />
                                <rect width="16" height="18" x="4" y="4" rx="2" />
                                <path d="M8 10h6" />
                                <path d="M8 14h8" />
                                <path d="M8 18h5" />
                            </svg>
                            <div class="w-3/5 flex flex-col md:flex-row ml-[1vw] md:ml-0">
                                <p class="md:w-3/7 text-blue-600 text-[3.1vw] md:text-[1.1vw] p-[0.2vw]  md:p-[1.2vw]">
                                    <%=e.aplId%>
                                </p>
                                <p class="md:w-2/7  text-[2.3vw] md:text-[1.1vw] p-[0.2vw]  md:p-[1.2vw]">
                                    <%=e.vhNum%>
                                </p>
                                <p class="md:w-2/7  text-[2.3vw] md:text-[1.1vw] p-[0.2vw]  md:p-[1.2vw]">
                                    <%= e.appliedDate.toLocaleDateString("en-IN", { day: "2-digit" , month: "short" ,
                                        year: "numeric" }) %>
                                </p>
                            </div>
                            <div class="w-2/5 flex flex-col gap-[2vw] md:gap-0 md:flex-row">
                                <p
                                    class="w-full md:w-1/2 flex flex justify-end md:justify-start text-[2vw] md:text-[1.1vw] p-[0.2vw]  md:p-[0.7vw]">



                                    <% if(e.status==="Rejected" ){ %>
                                        <span
                                            class="bg-red-200 p-[0.5vw] text-red-700 px-[1.7vw] md:px-[1vw] rounded-full">Rejected</span>


                                        <%} else if(e.status==="Approved" ){ %>
                                            <span
                                                class="bg-green-200 p-[0.5vw] text-green-700 px-[1.7vw] md:px-[1vw] rounded-full">Approved</span>

                                            <%} else{ %>
                                                <span
                                                    class="bg-yellow-200 p-[0.5vw] text-yellow-700 px-[1.7vw] md:px-[1vw] rounded-full">Pending</span>

                                                <%} %>
                                </p>
                                <p
                                    class="w-full md:w-1/2 flex justify-end md:justify-start text-[2vw] md:text-[1.1vw] font-sm md:font-medium p-[0.7vw]">
                                    <a class="text-blue-600  border-1 flex justify-center gap-[0.6vw] items-center border-blue-600 w-[20vw] md:w-[10vw] rounded-sm md:rounded-md p-[0.5vw]"
                                        href="/admin/applicationDetail/<%=e._id%>"> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="lucide lucide-eye-icon lucide-eye h-[3vw] md:h-[1.2vw]">
                                            <path
                                                d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg> View details</a>
                                </p>
                            </div>
                        </div>
                        <hr class="border-0.5 hidden md:flex border-gray-200 w-[97%] ">
                    </div>

                    <% }) %>




                        <!-- --------------------------------------------------------    Repeat End--------------------------------------------------------- -->
                        
                        








            </div>



            <!-- ---------------------------------------------------------------------------------------------------------------- section end  -->
        </div>

    </section>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js"
        integrity="sha512-NcZdtrT77bJr4STcmsGAESr06BYGE8woZdSdEgqnpyqac7sugNO+Tr4bGwGF3MsnEkGKhU2KL2xh6Ec+BqsaHA=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>

        window.addEventListener("pageshow", function (event) {

            if (event.persisted) {
                window.location.reload();
            }

        });

        function followLink(event,element){
            event.preventDefault();
            window.location.replace(element.href);
        }

        async function goLink(event, element) {
            event.preventDefault();
            let response = await fetch(element.href);

            if (!response.ok) {
                throw new Error("Logout failed");
            }
            let data = await response.json();
            if (data.success) {
                window.location.replace("/admin/login");
            }
            else {
                alert(data.message);
            }
        }
    </script>
    <script src="/scripts/sidebar.js"></script>
</body>

</html>