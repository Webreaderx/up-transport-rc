                        class="p-[2vw] md:p-[1vw] w-19/20 md:w-auto mt-[2vw] md:mt-0 cursor-pointer text-[2.7vw] md:text-[1vw] bg-blue-600 rounded-md font-medium text-white"
                        type="submit" value="Submit Application">

                </div>



                <!-- --------------------------------------------------------------------------------------- -->
            </form>
            <%} else{ %>
