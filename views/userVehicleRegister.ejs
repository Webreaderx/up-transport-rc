                    <p class="text-xs md:text-[0.9vw] border-r-3 border-zinc-300 pr-3">Goverment of Uttar Pradesh</p>
                </div>
            </div>
            <div class="h-full flex gap-[0.6vw] items-center">
                <% if(user.profilepic.data){%>
                    <img class=" h-[10vw] w-[10vw] md:h-[4vw] md:w-[4vw] rounded-full object-cover"
