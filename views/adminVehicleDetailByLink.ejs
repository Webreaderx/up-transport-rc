    <script>
        const base = document.getElementById("base");

        function followLink(event,element){
            event.preventDefault();
            window.location.replace(element.href);
        }

        async function approveApp(id){
            event.preventDefault();
            try {
                base.classList.add("opacity-50");
                base.classList.add("bg-black");
                let response = await fetch(`/admin/approve/${id}`);

                if(!response.ok){
                    throw new Error("Approve failed");
                }

                let data = await response.json();
                if(data.success){
                    base.classList.remove("opacity-50");
                    base.classList.remove("bg-black");
                    window.location.reload();
                }
                
            } catch (error) {
                alert(error.message);
            }

        }
        async function rejectApp(id){
            event.preventDefault();
            try {
                base.classList.add("opacity-50");
                base.classList.add("bg-black");
                let response = await fetch(`/admin/reject/${id}`);

                if(!response.ok){
                    throw new Error("Rejection failed");
                }

                let data = await response.json();
                if(data.success){
                    base.classList.remove("opacity-50");
                    base.classList.remove("bg-black");
                    window.location.reload();
                }
                
            } catch (error) {
                alert(error.message);
            }

        }

        async function goLink(event, element) {
            event.preventDefault();
            let response = await fetch(element.href);

            if (!response.ok) {
                throw new Error("Logout failed");
            }
            let data = await response.json();
            if (data.success) {
                window.location.replace("/admin/login");
            }
            else {
                alert(data.message);
            }
        }

        function goPage(event, element) {

            event.preventDefault();

            window.location.replace(element.href);

        }

        async function deleteApp(id) {

            try {



                let response = await fetch(`/admin/appDelete/${id}`);

                if (!response.ok) {
                    throw new Error("Delete Failed");
                }

                let data = await response.json();

                if (data.success) {
                    window.history.back();
                }
                else{
                    alert(data.message)
                }

            }
            catch (error) {
                alert(error.message);
            }

        }
    </script>
