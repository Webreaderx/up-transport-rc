    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js"
        integrity="sha512-NcZdtrT77bJr4STcmsGAESr06BYGE8woZdSdEgqnpyqac7sugNO+Tr4bGwGF3MsnEkGKhU2KL2xh6Ec+BqsaHA=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>

        const formsec = document.getElementById("formsec");

        window.addEventListener("pageshow", function (event) {

            if (event.persisted) {
                window.location.reload();
            }

        });

        function followLink(event, element) {
            event.preventDefault();
            window.location.replace(element.href);
        }

        async function goLink(event, element) {
            event.preventDefault();
            let response = await fetch(element.href);

            if (!response.ok) {
                throw new Error("Logout failed");
            }
            let data = await response.json();
            if (data.success) {
                window.location.replace("/admin/login");
            }
            else {
                alert(data.message);
            }
        }

        formsec.addEventListener("submit", async (e) => {
            e.preventDefault();
            const inFile = document.getElementById("inFile").files[0];

            const formData = new FormData();
            formData.append("dp", inFile);


            let response = await fetch("/admin/profilepic", {
                method: 'POST',
                body: formData

            })

            if (!response.ok) {
                throw new Error("Image Updation failed");
            }
            let data = await response.json();
            if (!data.success) {
                alert(data.message);
            }
            window.location.reload();
        })
    </script>

    <script src="/scripts/imageformsec.js"></script>
    <script src="/scripts/sidebar.js"></script>
</body>

